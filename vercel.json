{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)/$",
      "destination": "/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}